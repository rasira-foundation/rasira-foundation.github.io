# Google Sheet ID from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit#gid=0
# The sheet must be shared as "Anyone with the link can view" (or published to web).
VITE_SHEET_ID=

# Which tab to read. Either set the gid from the URL's "#gid=" (0 is the
# first tab, the default), OR set VITE_SHEET_NAME to address it by name —
# if both are set, the name wins.
VITE_SHEET_GID=0
VITE_SHEET_NAME=
